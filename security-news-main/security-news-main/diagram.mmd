flowchart TB
    classDef ext fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 5 5,color:#000
    classDef db fill:#fff8e1,stroke:#f57f17,stroke-width:2px,color:#000
    classDef tech fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#000
    classDef front fill:#f3e5f5,stroke:#8e24aa,stroke-width:1px,color:#000
    classDef ai fill:#fce4ec,stroke:#d81b60,stroke-width:2px,color:#000

    subgraph EXTERNAL["🌐 External Ecosystem (Internet)"]
        direction LR
        RSS["📰 RSS & Atom Feeds<br>(31 sources: CERT-FR, ZDI, ANSSI, GitHub Releases...)"]:::ext
        NVD["🇺🇸 Official APIs<br>(NVD NIST v2, CISA KEV)"]:::ext
        CLAUDE["🧠 Anthropic API<br>(claude-haiku-4-5)"]:::ai
    end

    subgraph DOCKER["🐳 Debian VPS — Docker Network (/opt/securitynews)"]

        subgraph WORKER["⚙️ secnews-worker"]
            NODE["🟩 Node.js 22 (Runtime)"]:::tech
            TS2["🔵 TypeScript + Zod<br>(Typing & Runtime Validation)"]:::tech
            PGBOSS["⏱ pg-boss<br>(Cron scheduler)"]:::tech
            SCHED["📋 scheduler.ts<br>(Registers jobs & schedules)"]:::tech
            FETCH["📥 rss-fetcher.ts<br>(Fetch → Validate → Score → INSERT<br>+ updateProfileRelevance JSONB)"]:::tech
            AI_SVC["🤖 ai-summary.ts<br>(SELECT top 50 → FR/EN prompts → Claude)"]:::tech
        end

        subgraph DB["🗄️ secnews-postgres"]
            PG[("🐘 PostgreSQL 17-alpine<br>articles · summaries · profiles<br>rss_sources · pgboss schema")]:::db
        end

        subgraph CACHE["⚡ secnews-redis"]
            REDIS[("🔴 Redis 8-alpine<br>Caches parsed feed arrays<br>per source — TTL 2h")]:::db
        end

        subgraph FRONTEND["🖥️ secnews-frontend (Port 3000)"]
            ASTRO["🚀 Astro SSR"]:::front
            REACT["⚛️ React Islands<br>(CVEChart, PDFExport — client:load)"]:::front
            CHART["📊 Chart.js (via CVEChart.tsx)"]:::front
            I18N["🌍 i18n.ts + lib/db.ts<br>(?lang= → WHERE lang='fr'/'en')"]:::front
        end

    end

    USER(("👤 User<br>(Browser)")):::front

    %% Data Ingestion Flow
    RSS --> FETCH
    NVD --> FETCH
    FETCH -->|"Cache check (2h TTL)"| REDIS
    FETCH -->|"INSERT articles + update profile_relevance<br>(via pg Pool raw query)"| PG

    %% Job Scheduling Flow
    PGBOSS -->|"Job queue storage<br>(pgboss schema)"| PG
    PGBOSS -.->|"Triggers"| SCHED
    SCHED -.->|"Every 2h"| FETCH
    SCHED -.->|"06:00 daily · Mon weekly · 1st monthly"| AI_SVC

    %% AI Summary Flow
    AI_SVC -->|"SELECT top 50 scored articles<br>(via pg Pool raw query)"| PG
    AI_SVC -->|"FR prompt + EN prompt"| CLAUDE
    CLAUDE -->|"Returns Markdown"| AI_SVC
    AI_SVC -->|"INSERT summaries<br>(lang=fr + lang=en)"| PG

    %% Frontend Flow
    USER -->|"HTTP GET /?lang=fr"| ASTRO
    ASTRO -->|"SELECT data WHERE lang='...' <br>(via pg Pool raw query)"| PG
    I18N -.->|"Sets lang condition"| ASTRO
    REACT -.-> ASTRO
    CHART -.-> REACT
