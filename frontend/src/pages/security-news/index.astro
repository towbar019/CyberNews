---
import Base from "../../layouts/Base.astro";
import { getProfiles } from "../../lib/db";
import { getLang } from "../../lib/i18n";

const lang = getLang(Astro.url);
const langQ = lang === "en" ? "?lang=en" : "";

let profiles: Awaited<ReturnType<typeof getProfiles>> = [];
let dbError = false;

try {
  profiles = await getProfiles();
} catch (e) {
  console.error("[security-news] DB error:", e);
  dbError = true;
}
---

<Base title="SecurityNews">
  <div class="page">
    <div class="page-header">
      <h1 class="page-title">SecurityNews</h1>
      <p class="page-sub">{lang === "en" ? "AI summaries — Daily, Weekly, Monthly per profile" : "Résumés AI — Daily, Weekly, Monthly par profil"}</p>
    </div>

    {dbError && <div class="empty-state">{lang === "en" ? "Database unavailable." : "Base de données non disponible."}</div>}

    {!dbError && (
      <div class="profiles-nav">
        {profiles.map((p) => (
          <a href={`/security-news/${p.name.toLowerCase()}${langQ}`} class="profile-nav-card">
            <span class="profile-nav-name">{p.name}</span>
            <span class="profile-nav-sub">{p.config.description}</span>
            <span class="profile-nav-go">{lang === "en" ? "View summaries →" : "Voir les résumés →"}</span>
          </a>
        ))}
        {profiles.length === 0 && (
          <div class="empty-state" style="width:100%;">{lang === "en" ? "Loading…" : "Chargement…"}</div>
        )}
      </div>
    )}
  </div>
</Base>

<style>
  .page { max-width: 980px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .page-header { margin-bottom: 2rem; }
  .page-title { font-size: 1.6rem; font-weight: 720; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .page-sub { color: var(--muted); font-size: 0.92rem; }

  .profiles-nav {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  .profile-nav-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-decoration: none;
    transition: border-color .15s;
  }
  .profile-nav-card:hover { border-color: var(--accent); }
  .profile-nav-card:hover .profile-nav-go { color: var(--accent); }

  .profile-nav-name { font-size: 1.05rem; font-weight: 700; color: var(--text); letter-spacing: 0.02em; }
  .profile-nav-sub { font-size: 0.83rem; color: var(--muted); line-height: 1.55; }
  .profile-nav-go { font-size: 0.78rem; color: var(--faint); margin-top: 0.4rem; transition: color .15s; }

  .empty-state {
    border: 1px dashed var(--border2);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
