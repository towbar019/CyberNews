---
import Base from "../../layouts/Base.astro";
import CVEChart from "../../components/CVEChart";
import PDFExportButton from "../../components/PDFExportButton";
import {
  getProfileByName,
  getLatestSummary,
  getArticlesForProfile,
  getArticlesForProfileRange,
  getSummaryForDate,
  getSourcesForProfile,
  getSourcesForProfileRange,
  getCveChartData,
  getBigAlertArticles,
} from "../../lib/db";
import { getLang, t } from "../../lib/i18n";
import {
  markdownToHtml,
  safeUrl,
  TabSchema,
  ProfileSlugSchema,
  RangeSchema,
  parseDateParam,
  parseMonthParam,
} from "../../lib/security";

const profileSlug = ProfileSlugSchema.parse(Astro.params.profile ?? "");
const lang = getLang(Astro.url);
const tab = TabSchema.parse(Astro.url.searchParams.get("tab") ?? "daily");
// summary = briefing condensé | detailed = briefing réécrit enrichi (sources par
// paragraphe) | articles = liste brute des articles
const viewRaw = Astro.url.searchParams.get("view") ?? "summary";
const viewMode = (["summary", "detailed", "articles"].includes(viewRaw) ? viewRaw : "summary") as "summary" | "detailed" | "articles";
const summaryMode = viewMode === "detailed" ? "detailed" : "concise";

// ── Kibana-like time picker ──────────────────────────────────────────────────
// range=day  + date=YYYY-MM-DD  → journée précise
// range=week + date=YYYY-MM-DD  → semaine contenant cette date (lundi → dimanche)
// range=month + month=YYYY-MM   → mois entier
// aucun paramètre → live (dernières données)
const range = RangeSchema.parse(Astro.url.searchParams.get("range") ?? "day");
const selectedDate = parseDateParam(Astro.url.searchParams.get("date"));
const selectedMonth = parseMonthParam(Astro.url.searchParams.get("month"));

let rangeStart: Date | null = null;
let rangeEnd: Date | null = null;
if (range === "month" && selectedMonth) {
  rangeStart = selectedMonth;
  rangeEnd = new Date(Date.UTC(selectedMonth.getUTCFullYear(), selectedMonth.getUTCMonth() + 1, 1));
} else if (range === "week" && selectedDate) {
  const dow = selectedDate.getUTCDay();
  const daysToMon = dow === 0 ? 6 : dow - 1;
  rangeStart = new Date(Date.UTC(selectedDate.getUTCFullYear(), selectedDate.getUTCMonth(), selectedDate.getUTCDate() - daysToMon));
  rangeEnd = new Date(rangeStart.getTime() + 7 * 24 * 3600 * 1000);
} else if (range === "day" && selectedDate) {
  rangeStart = new Date(Date.UTC(selectedDate.getUTCFullYear(), selectedDate.getUTCMonth(), selectedDate.getUTCDate()));
  rangeEnd = new Date(rangeStart.getTime() + 24 * 3600 * 1000);
}
const hasRange = rangeStart !== null && rangeEnd !== null;

let profile = null;
let summary = null;
let articlesData = { articles: [] as any[], total: 0 };
let cveData: any[] = [];
let bigAlerts: any[] = [];
let sources: { source: string; count: number }[] = [];
let dbError = false;

try {
  profile = await getProfileByName(profileSlug);
  if (profile) {
    if (hasRange) {
      // Le summary suit la granularité choisie : day→daily, week→weekly, month→monthly
      const summaryTab = range === "week" ? "weekly" : range === "month" ? "monthly" : tab;
      [summary, articlesData, sources] = await Promise.all([
        getSummaryForDate(profile.id, summaryTab, rangeStart!, lang, summaryMode),
        getArticlesForProfileRange(profile.id, rangeStart!, rangeEnd!, 100),
        getSourcesForProfileRange(profile.id, rangeStart!, rangeEnd!),
      ]);
    } else {
      [summary, articlesData, bigAlerts, sources] = await Promise.all([
        getLatestSummary(profile.id, tab, lang, summaryMode),
        getArticlesForProfile(profile.id, 1, 80),
        getBigAlertArticles(),
        getSourcesForProfile(profile.id),
      ]);
    }
    if (profile.config.showCveChart && (profile.config.monitoredApps ?? []).length > 0) {
      cveData = await getCveChartData(profile.id, profile.config.monitoredApps ?? []);
    }
  }
} catch (e) {
  console.error(`[profile-page] DB error for "${profileSlug}":`, e);
  dbError = true;
}

if (!profile && !dbError) return Astro.redirect("/security-news");

const showCveChart = Boolean(profile?.config.showCveChart) && (profile?.config.monitoredApps ?? []).length > 0;

const tabs = [
  { id: "daily",   label: "Daily" },
  { id: "weekly",  label: "Weekly" },
  { id: "monthly", label: "Monthly" },
] as const;

const todayStr = new Date().toISOString().slice(0, 10);
const selectedDateStr = selectedDate ? selectedDate.toISOString().slice(0, 10) : "";
const selectedMonthStr = selectedMonth ? selectedMonth.toISOString().slice(0, 7) : "";

function shiftDate(d: string, days: number): string {
  const dt = new Date(d + "T00:00:00Z");
  dt.setUTCDate(dt.getUTCDate() + days);
  return dt.toISOString().slice(0, 10);
}
function shiftMonth(m: string, months: number): string {
  const dt = new Date(m + "-01T00:00:00Z");
  dt.setUTCMonth(dt.getUTCMonth() + months);
  return dt.toISOString().slice(0, 7);
}

function makeUrl(params: Record<string, string | null>): string {
  const base = new URLSearchParams();
  base.set("tab", tab);
  base.set("view", viewMode);
  if (lang === "en") base.set("lang", "en");
  if (hasRange) {
    base.set("range", range);
    if (range === "month" && selectedMonthStr) base.set("month", selectedMonthStr);
    else if (selectedDateStr) base.set("date", selectedDateStr);
  }
  for (const [k, v] of Object.entries(params)) {
    if (v === null) base.delete(k); else base.set(k, v);
  }
  return `/security-news/${profileSlug}?${base.toString()}`;
}

// Range display label
const rangeLabel = hasRange
  ? range === "month"
    ? rangeStart!.toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { month: "long", year: "numeric" })
    : range === "week"
    ? `${rangeStart!.toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { day: "numeric", month: "short" })} → ${new Date(rangeEnd!.getTime() - 1).toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { day: "numeric", month: "short", year: "numeric" })}`
    : rangeStart!.toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" })
  : "";

const prevLink = hasRange
  ? range === "month"
    ? makeUrl({ month: shiftMonth(selectedMonthStr, -1) })
    : makeUrl({ date: shiftDate(selectedDateStr, range === "week" ? -7 : -1) })
  : "#";
const nextTarget = hasRange
  ? range === "month" ? shiftMonth(selectedMonthStr, 1) : shiftDate(selectedDateStr, range === "week" ? 7 : 1)
  : "";
const nextAllowed = hasRange && (range === "month" ? nextTarget <= todayStr.slice(0, 7) : nextTarget <= todayStr);
const nextLink = nextAllowed
  ? range === "month" ? makeUrl({ month: nextTarget }) : makeUrl({ date: nextTarget })
  : "#";
---

<Base title={profile?.name ?? "Profile"}>
  <div class="page">

    {dbError && <div class="empty-state">{lang === "en" ? "Database unavailable." : "Base de données non disponible."}</div>}

    {!dbError && profile && (
      <>
        <!-- Header compact -->
        <div class="profile-header">
          <div class="breadcrumb">
            <a href="/security-news">SecurityNews</a>
            <span class="bc-sep">/</span>
            <span>{profile.name}</span>
          </div>
          <div class="profile-title-row">
            <h1 class="profile-title">{profile.name}</h1>
            <span class="articles-count">{articlesData.total} articles</span>
          </div>
          <p class="profile-desc">{profile.config.description}</p>
        </div>

        <!-- ALERTES CRITIQUES — première info lue -->
        {bigAlerts.length > 0 && (
          <div class="inline-alert">
            <span class="inline-alert-label">
              {bigAlerts.length} {bigAlerts.length > 1 ? t("news","alerts_label",lang) : t("news","alert_label",lang)} {bigAlerts.length > 1 ? t("news","criticals",lang) : t("news","critical",lang)}
            </span>
            <span class="inline-alert-sub">CISA KEV / CVSS ≥ 9.8</span>
          </div>
        )}

        <!-- Tabs + View toggle -->
        <div class="tabs-row">
          <div class="tabs">
            {tabs.map((tb) => (
              <a
                href={makeUrl({ tab: tb.id })}
                class={`tab${tab === tb.id ? " tab-active" : ""}`}
              >
                {tb.label}
              </a>
            ))}
          </div>
          <div class="view-toggle">
            <a href={makeUrl({ view: "summary" })} class={`vtoggle${viewMode === "summary" ? " vtoggle-active" : ""}`}>{lang === "en" ? "Summary" : "Résumé"}</a>
            <a href={makeUrl({ view: "detailed" })} class={`vtoggle${viewMode === "detailed" ? " vtoggle-active" : ""}`}>{lang === "en" ? "Detailed" : "Détaillé"}</a>
            <a href={makeUrl({ view: "articles" })} class={`vtoggle${viewMode === "articles" ? " vtoggle-active" : ""}`}>{lang === "en" ? "Articles" : "Articles"}</a>
          </div>
        </div>

        <!-- ═══ Time picker (Kibana-like) ═══ -->
        <div class="time-picker">
          <div class="tp-left">
            {hasRange ? (
              <>
                <a href={prevLink} class="tp-nav">‹</a>
                <span class="tp-current">
                  <svg class="tp-cal" width="13" height="13" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="2.5" width="13" height="12" rx="2" stroke="currentColor"/><path d="M1.5 6h13" stroke="currentColor"/><path d="M5 1v3M11 1v3" stroke="currentColor" stroke-linecap="round"/></svg>
                  {rangeLabel}
                </span>
                {nextAllowed ? <a href={nextLink} class="tp-nav">›</a> : <span class="tp-nav tp-nav-disabled">›</span>}
                <a href={makeUrl({ date: null, month: null, range: null })} class="tp-live-link">
                  ↩ {lang === "en" ? "Back to live" : "Retour au live"}
                </a>
              </>
            ) : (
              <span class="tp-live"><span class="live-dot"></span>{lang === "en" ? "Live — latest data" : "Live — dernières données"}</span>
            )}
          </div>

          <div class="tp-right">
            <span class="tp-label">{lang === "en" ? "Jump to:" : "Aller à :"}</span>
            <!-- Granularité day / week / month -->
            <div class="tp-modes">
              <button class={`tp-mode${hasRange && range === "day" ? " tp-mode-active" : ""}`} data-mode="day">{lang === "en" ? "Day" : "Jour"}</button>
              <button class={`tp-mode${hasRange && range === "week" ? " tp-mode-active" : ""}`} data-mode="week">{lang === "en" ? "Week" : "Semaine"}</button>
              <button class={`tp-mode${hasRange && range === "month" ? " tp-mode-active" : ""}`} data-mode="month">{lang === "en" ? "Month" : "Mois"}</button>
            </div>
            <input type="date" id="tp-date-input" class="date-input" max={todayStr} value={selectedDateStr || todayStr} style={hasRange && range === "month" ? "display:none" : ""} />
            <input type="month" id="tp-month-input" class="date-input" max={todayStr.slice(0, 7)} value={selectedMonthStr || todayStr.slice(0, 7)} style={!(hasRange && range === "month") ? "display:none" : ""} />
            <button id="tp-apply" class="tp-apply">OK →</button>
            <!-- Presets rapides -->
            <div class="tp-presets">
              <button class="tp-preset" data-preset="yesterday">{lang === "en" ? "Yesterday" : "Hier"}</button>
              <button class="tp-preset" data-preset="thisweek">{lang === "en" ? "This week" : "Cette semaine"}</button>
              <button class="tp-preset" data-preset="lastweek">{lang === "en" ? "Last week" : "Semaine dernière"}</button>
              <button class="tp-preset" data-preset="thismonth">{lang === "en" ? "This month" : "Ce mois"}</button>
            </div>
          </div>
        </div>

        <script is:inline define:vars={{ profileSlug, tab, viewMode, lang, currentRange: hasRange ? range : "day" }}>
          (function () {
            let mode = currentRange;
            const dateInput = document.getElementById("tp-date-input");
            const monthInput = document.getElementById("tp-month-input");

            function go(params) {
              const q = new URLSearchParams({ tab, view: viewMode });
              if (lang === "en") q.set("lang", "en");
              for (const k in params) q.set(k, params[k]);
              window.location.href = "/security-news/" + profileSlug + "?" + q.toString();
            }
            function fmtDate(d) { return d.toISOString().slice(0, 10); }

            // Navigation robuste : selon le navigateur, cliquer un jour dans le
            // calendrier natif émet 'change' OU seulement 'input'. On écoute les
            // deux (avec garde anti-double) + bouton OK en secours.
            let navigating = false;
            function applyDate() {
              if (navigating) return;
              if (mode === "month") {
                if (monthInput.value) { navigating = true; go({ range: "month", month: monthInput.value }); }
              } else {
                if (dateInput.value) { navigating = true; go({ range: mode === "month" ? "day" : mode, date: dateInput.value }); }
              }
            }

            document.querySelectorAll(".tp-mode").forEach((btn) => {
              btn.addEventListener("click", () => {
                mode = btn.dataset.mode;
                document.querySelectorAll(".tp-mode").forEach((b) => b.classList.toggle("tp-mode-active", b === btn));
                dateInput.style.display = mode === "month" ? "none" : "";
                monthInput.style.display = mode === "month" ? "" : "none";
              });
            });

            // 'change' = validation classique ; 'input' = clic direct sur un jour
            // (Firefox/Chrome selon versions). Petite temporisation sur 'input'
            // pour laisser le calendrier se fermer proprement.
            dateInput.addEventListener("change", applyDate);
            dateInput.addEventListener("input", () => setTimeout(applyDate, 150));
            monthInput.addEventListener("change", applyDate);
            monthInput.addEventListener("input", () => setTimeout(applyDate, 150));
            document.getElementById("tp-apply").addEventListener("click", applyDate);

            document.querySelectorAll(".tp-preset").forEach((btn) => {
              btn.addEventListener("click", () => {
                const now = new Date();
                const p = btn.dataset.preset;
                if (p === "yesterday") {
                  const d = new Date(now); d.setDate(d.getDate() - 1);
                  go({ range: "day", date: fmtDate(d) });
                } else if (p === "thisweek") {
                  go({ range: "week", date: fmtDate(now) });
                } else if (p === "lastweek") {
                  const d = new Date(now); d.setDate(d.getDate() - 7);
                  go({ range: "week", date: fmtDate(d) });
                } else if (p === "thismonth") {
                  go({ range: "month", month: fmtDate(now).slice(0, 7) });
                }
              });
            });
          })();
        </script>

        <!-- Layout -->
        <div class={`layout${showCveChart ? "" : " layout-nochart"}`}>
          <!-- Left -->
          <div class="layout-main">

            {/* RÉSUMÉ / DÉTAILLÉ : AI summary card (le détaillé est le briefing réécrit enrichi) */}
            {(viewMode === "summary" || viewMode === "detailed") && (
              <div class="card">
                <div class="card-header">
                  <div>
                    <div class="card-label">
                      {lang === "en" ? "AI Summary" : "Résumé AI"}
                      {viewMode === "detailed" ? (lang === "en" ? " (detailed)" : " (détaillé)") : ""}
                      {" — "}{tab === "daily" ? t("news","summary_today",lang) : tab === "weekly" ? t("news","summary_week",lang) : t("news","summary_month",lang)}
                    </div>
                    {summary && (
                      <div class="card-meta">
                        {t("news","generated",lang)} {new Date(summary.generated_at).toLocaleString(lang === "en" ? "en-GB" : "fr-FR")}
                        {viewMode === "detailed" && (summary as any).mode === "concise" && (
                          <span> — {lang === "en" ? "detailed version not generated yet, showing summary" : "version détaillée pas encore générée, affichage du résumé"}</span>
                        )}
                      </div>
                    )}
                  </div>
                  {summary && (
                    <PDFExportButton
                      client:load
                      profileName={profile.name}
                      content={summary.content_md}
                    />
                  )}
                </div>
                <div class="card-body">
                  {!summary && (
                    <div class="empty-summary">
                      <div>{t("news","no_summary",lang)} {tab} {lang === "en" ? "generated" : "généré"}.</div>
                      <div class="empty-summary-when">
                        {tab === "daily" && t("news","next_daily",lang)}
                        {tab === "weekly" && t("news","next_weekly",lang)}
                        {tab === "monthly" && t("news","next_monthly",lang)}
                      </div>
                    </div>
                  )}
                  {summary && (
                    <div class="summary-content" set:html={markdownToHtml(summary.content_md)} />
                  )}
                </div>
              </div>
            )}

            {/* MODE ARTICLES : liste brute avec CVSS + source */}
            {viewMode === "articles" && (
              <div class="card">
                <div class="card-header">
                  <div class="card-label">{lang === "en" ? "Raw articles" : "Articles bruts"} — {articlesData.total} {t("news","articles",lang)}</div>
                  <span class="card-meta">{articlesData.articles.length} {lang === "en" ? "shown" : "affichés"}</span>
                </div>
                <div class="card-body articles-list">
                  {articlesData.articles.length === 0 && (
                    <div class="empty-summary">{lang === "en" ? "No articles available." : "Aucun article disponible."}</div>
                  )}
                  {articlesData.articles.map((a: any) => (
                    <div class={`article-row${a.is_cisa_kev ? " article-kev" : ""}${a.cvss_score >= 9 ? " article-critical" : ""}`}>
                      <div class="article-meta">
                        <span class="article-source">{a.source}</span>
                        {a.is_cisa_kev && <span class="badge-kev">CISA KEV</span>}
                        {a.cvss_score && (
                          <span class={`badge-cvss${a.cvss_score >= 9 ? " cvss-critical" : a.cvss_score >= 7 ? " cvss-high" : ""}`}>
                            CVSS {a.cvss_score.toFixed(1)}
                          </span>
                        )}
                        <span class="article-date">{new Date(a.published_at).toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR")}</span>
                      </div>
                      <a href={safeUrl(a.url)} target="_blank" rel="noopener noreferrer" class="article-title">{a.title}</a>
                      {a.content && (
                        <p class="article-snippet">{a.content.slice(0, 200)}{a.content.length > 200 ? "…" : ""}</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Right sidebar : sources + monitored apps -->
          <div class="layout-side">
            {sources.length > 0 && (
              <div class="card">
                <div class="card-header">
                  <div class="card-label">Sources — {articlesData.total} {t("news","articles",lang)}</div>
                  {hasRange && <span class="card-meta">{lang === "en" ? "filtered" : "filtré"}</span>}
                </div>
                <div class="card-body">
                  <div class="sources-list">
                    {sources.map((s) => (
                      <div class="source-row">
                        <span class="source-name">{s.source}</span>
                        <div class="source-bar-wrap">
                          <div
                            class="source-bar"
                            style={`width: ${Math.round((s.count / sources[0].count) * 100)}%`}
                          />
                        </div>
                        <span class="source-count">{s.count}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {(profile.config.monitoredApps ?? []).length > 0 && (
              <div class="card">
                <div class="card-header">
                  <div class="card-label">{t("news","monitored",lang)}</div>
                </div>
                <div class="card-body">
                  <div class="apps-grid">
                    {(profile.config.monitoredApps ?? []).map((app: string) => (
                      <a href={`/security-news/${profileSlug}/cve?app=${encodeURIComponent(app)}${lang === "en" ? "&lang=en" : ""}`} class="app-tag">{app}</a>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- ═══ CVE CHART — full width, Nemea only (showCveChart) ═══ -->
        {showCveChart && (
          <div class="card cve-chart-card">
            <div class="card-header">
              <div class="card-label">{t("news","cve_chart",lang)}</div>
              <a href={`/security-news/${profileSlug}/cve${lang === "en" ? "?lang=en" : ""}`} class="cve-explore-link">
                {lang === "en" ? "Open CVE explorer →" : "Ouvrir l'explorateur CVE →"}
              </a>
            </div>
            <div class="card-body">
              <CVEChart
                client:load
                data={cveData}
                monitoredApps={profile.config.monitoredApps ?? []}
                profileSlug={profileSlug}
                lang={lang}
              />
            </div>
          </div>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .page { max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.5rem; }

  /* Header */
  .breadcrumb { font-size: 0.76rem; color: var(--faint); margin-bottom: 0.9rem; display: flex; gap: 0.4rem; align-items: center; }
  .breadcrumb a { color: var(--faint); }
  .breadcrumb a:hover { color: var(--accent); }
  .bc-sep { color: var(--border2); }
  .profile-header { margin-bottom: 1.75rem; }
  .profile-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .profile-title { font-size: 1.6rem; font-weight: 720; letter-spacing: -0.01em; color: var(--text); margin-bottom: 0.25rem; }
  .profile-desc { color: var(--muted); font-size: 0.88rem; line-height: 1.55; max-width: 640px; }
  .articles-count { font-size: 0.78rem; color: var(--faint); white-space: nowrap; }

  /* Alert */
  .inline-alert {
    border: 1px solid #f0554d40;
    border-left: 3px solid var(--red);
    background: #f0554d0a;
    border-radius: 7px;
    padding: 0.65rem 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .inline-alert-label { font-size: 0.82rem; font-weight: 700; color: var(--red); }
  .inline-alert-sub { font-size: 0.74rem; color: var(--faint); }

  /* Tabs row */
  .tabs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .tabs { display: flex; gap: 0; }
  .tab {
    padding: 0.6rem 1.15rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition: color .15s, border-color .15s;
    margin-bottom: -1px;
  }
  .tab:hover { color: var(--text); }
  .tab-active { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }

  /* View toggle */
  .view-toggle { display: flex; gap: 0.35rem; padding-bottom: 0.5rem; }
  .vtoggle {
    padding: 0.3rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: all .15s;
  }
  .vtoggle:hover { color: var(--text); border-color: var(--border2); }
  .vtoggle-active { color: var(--text); border-color: var(--accent); background: var(--accent-dim); font-weight: 600; }

  /* ═══ Time picker (Kibana-like) ═══ */
  .time-picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--border);
