---
import Base from "../../layouts/Base.astro";
import { getProfiles } from "../../lib/db";
import { getLang, t } from "../../lib/i18n";

const lang = getLang(Astro.url);

let profiles: Awaited<ReturnType<typeof getProfiles>> = [];
let dbError = false;

try {
  profiles = await getProfiles();
} catch (e) {
  console.error("[profiles] DB error:", e);
  dbError = true;
}

const langQ = lang === "en" ? "?lang=en" : "";

// Résumés éditoriaux des profils — la page Profils ne montre QUE ces résumés
// (les détails — apps surveillées, charts, briefings — vivent sur la page profil).
const profileSummaries: Record<string, { fr: string; en: string; scope: { fr: string; en: string } }> = {
  nemea: {
    fr: "Opérations SOC/CERT. Suivi strict des vulnérabilités exploitables, 0-days et CVE sur un périmètre d'applications défini. Alertes par sévérité (CISA KEV, CVSS), actions correctives concrètes.",
    en: "SOC/CERT operations. Strict tracking of exploitable vulnerabilities, 0-days and CVEs across a defined application perimeter. Severity-based alerts (CISA KEV, CVSS) with concrete remediation actions.",
    scope: {
      fr: "Périmètre : applications d'infrastructure surveillées (Proxmox, Teleport, Wazuh, Elastic…)",
      en: "Scope: monitored infrastructure applications (Proxmox, Teleport, Wazuh, Elastic…)",
    },
  },
  axel: {
    fr: "Vision macro CISO/RSSI. Synthèse exécutive des risques émergents, tendances cyber de haut niveau, réglementations (NIS2, DORA) et veille stratégique sur trois écosystèmes : IA, SecOps, Cloud & Souveraineté.",
    en: "Macro CISO view. Executive synthesis of emerging risks, high-level cyber trends, regulations (NIS2, DORA) and strategic watch across three ecosystems: AI, SecOps, Cloud & Sovereignty.",
    scope: {
      fr: "Périmètre : gouvernance & risque — pas de CVE individuelles",
      en: "Scope: governance & risk — no individual CVEs",
    },
  },
};
---

<Base title={t("profiles", "title", lang)}>
  <div class="page">
    <div class="page-header">
      <h1 class="page-title">{t("profiles", "title", lang)}</h1>
      <p class="page-sub">{t("profiles", "sub", lang)}</p>
    </div>

    {dbError && (
      <div class="empty-state">{t("profiles", "db_error", lang)}</div>
    )}

    {!dbError && profiles.length === 0 && (
      <div class="empty-state">{t("profiles", "loading", lang)}</div>
    )}

    <div class="profiles-list">
      {profiles.map((p) => {
        const slug = p.name.toLowerCase();
        const s = profileSummaries[slug];
        return (
          <a href={`/security-news/${slug}${langQ}`} class="profile-card">
            <div class="profile-head">
              <span class="profile-name">{p.name}</span>
              <span class="profile-cta">{t("profiles", "view", lang)}</span>
            </div>
            <p class="profile-summary">
              {s ? s[lang] : (p.config.description ?? "")}
            </p>
            {s && <p class="profile-scope">{s.scope[lang]}</p>}
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .page { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .page-header { margin-bottom: 2rem; }
  .page-title { font-size: 1.6rem; font-weight: 720; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .page-sub { color: var(--muted); font-size: 0.92rem; }

  .profiles-list { display: flex; flex-direction: column; gap: 0.9rem; }

  .profile-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .profile-card:hover { border-color: var(--accent); transform: translateY(-1px); }

  .profile-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.55rem; }
  .profile-name { font-size: 1.05rem; font-weight: 700; color: var(--text); letter-spacing: 0.01em; }
  .profile-cta { font-size: 0.78rem; color: var(--accent); font-weight: 600; white-space: nowrap; }

  .profile-summary { font-size: 0.88rem; color: var(--muted); line-height: 1.65; margin-bottom: 0.5rem; }
  .profile-scope { font-size: 0.75rem; color: var(--faint); font-style: italic; }

  .empty-state {
    border: 1px dashed var(--border2);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
</style>
